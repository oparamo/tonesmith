{
  "name": "@tonesmith/mcp",
  "version": "0.2.0",
  "description": "MCP server carrying the device knowledge an agent needs to build guitar multi-effects patches.",
  "keywords": [
    "guitar",
    "multi-effects",
    "patch",
    "preset",
    "boss",
    "gx-1",
    "tsl",
    "tone",
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "claude"
  ],
  "homepage": "https://github.com/oparamo/tonesmith#readme",
  "bugs": {
    "url": "https://github.com/oparamo/tonesmith/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "tonesmith-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc --noEmit && tsup",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@tonesmith/core": "workspace:*",
    "zod": "4.6.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/oparamo/tonesmith.git",
    "directory": "mcp"
  },
  "license": "MIT",
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "tsup": "8.5.1",
    "@vitest/coverage-v8": "5.0.5",
    "vitest": "5.0.5",
    "typescript": "6.0.3"
  }
}
