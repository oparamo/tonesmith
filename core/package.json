{
  "name": "@tonesmith/core",
  "version": "0.2.0",
  "description": "Read, edit, and build guitar multi-effects patch files. Each device is a driver behind one interface.",
  "keywords": [
    "guitar",
    "multi-effects",
    "patch",
    "preset",
    "boss",
    "gx-1",
    "tsl",
    "tone",
    "patch-file",
    "codec"
  ],
  "homepage": "https://github.com/oparamo/tonesmith#readme",
  "bugs": {
    "url": "https://github.com/oparamo/tonesmith/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsc --noEmit && tsup && tsc -p tsconfig.dts.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/oparamo/tonesmith.git",
    "directory": "core"
  },
  "license": "MIT",
  "devDependencies": {
    "tsup": "8.5.1",
    "@vitest/coverage-v8": "4.1.10",
    "vitest": "4.1.10"
  }
}
