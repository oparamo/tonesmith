.DS_Store

# Node
node_modules/
dist/
*.tsbuildinfo
coverage/
.npmrc

# Generated preset outputs (regenerate via pnpm --filter @tonesmith/core gen:*)
core/examples/**/*.tsl

# Track project-level Claude Code files despite personal global gitignore rules
# (CLAUDE.md and .claude are ignored globally so unrelated repos don't pick up local settings)
!CLAUDE.md
!.claude/
.claude/settings.local.json
